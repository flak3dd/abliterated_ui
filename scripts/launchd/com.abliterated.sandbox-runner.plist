<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.abliterated.sandbox-runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/adminuser/abliterated_ui/scripts/sandbox-watchdog.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/adminuser/abliterated_ui</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/abliterated-sandbox-watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/abliterated-sandbox-watchdog.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SANDBOX_PORT</key>
    <string>17330</string>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
