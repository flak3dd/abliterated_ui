# Server-side cloud keys (never shipped to the browser)
# Used by scripts/cloud-key-proxy.mjs and Vercel /api/cloud/*
FEATHERLESS_API_KEY=
ABLITERATION_API_KEY=

# Optional: Hugging Face Hub (gated models / downloads)
# Also accepted as HUGGING_FACE_HUB_TOKEN. Client Radar can save the same token
# into mesh AsyncStorage (@abliterated_mesh_api_keys_v1.huggingfaceApiKey).
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=
