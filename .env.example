
# Optional: Hugging Face Hub (gated models / downloads)
# Also accepted as HUGGING_FACE_HUB_TOKEN. Client Radar can save the same token
# into mesh AsyncStorage (@abliterated_mesh_api_keys_v1.huggingfaceApiKey).
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Server-side cloud keys (never shipped to the browser)
# Used by scripts/cloud-key-proxy.mjs and Vercel /api/cloud/*
# ==============================================================================
# Sovereign Spark & Abliterated UI — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# Server-side keys are gitignored and never exposed or shipped to the browser.
# They are injected server-side via scripts/cloud-key-proxy.mjs and Vercel /api/cloud/*
# ==============================================================================
# ------------------------------------------------------------------------------
# 1. Cloud AI Inference Keys
# ------------------------------------------------------------------------------
# Server-side key for Featherless AI (https://api.featherless.ai/v1)
FEATHERLESS_API_KEY=rc_a939625b5ebea3e527e07ee81d1d3ac10a77be72203eed6e53c3a81f4174a86a
# Server-side key for Sovereign Abliteration Cloud (https://api.abliteration.ai/v1)
ABLITERATION_API_KEY=ak_Ssvo89vmFy0FhbPqWDwiVyQtGzdvDuuHQqbW9VlgcJs
# Optional: Hugging Face Hub (gated models / downloads)
# Also accepted as HUGGING_FACE_HUB_TOKEN. Client Radar can save the same token
# into mesh AsyncStorage (@abliterated_mesh_api_keys_v1.huggingfaceApiKey).
# ------------------------------------------------------------------------------
# 2. Hugging Face Hub Access (Gated Models / Checkpoint Downloads)
# ------------------------------------------------------------------------------
# User access token from https://huggingface.co/settings/tokens
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=
# ------------------------------------------------------------------------------
# 3. NVIDIA DGX Spark Mesh Target (Blackwell GB10 Cluster)
# ------------------------------------------------------------------------------
# Direct IP or hostname of the active DGX Spark hardware node
# Common routes: 192.168.4.103 (Direct LAN), 100.94.45.77 (Tailscale), 127.0.0.1 (Loopback)
SPARK_HOST=192.168.4.103
SPARK_PORT=8000
# ------------------------------------------------------------------------------
# 4. Local Microservice & Proxy Daemons
# ------------------------------------------------------------------------------
# Cloud Key Proxy (:17332) - Injects cloud credentials for local web sessions
CLOUD_PROXY_HOST=127.0.0.1
CLOUD_PROXY_PORT=17332
# Ephemeral Sandbox Test Runner (:17330) - Executes test suites & code verification

# Sandbox live preview / headed Playwright
