{
  "name": "abliterated_ui",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^4.0.3",
    "expo": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.17",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-sharing": "~57.0.19",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.15.0",
    "react-native-worklets": "^0.10.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "playwright": "^1.55.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web && cp -f vercel.json dist/vercel.json && echo '/* /index.html 200' > dist/_redirects",
    "build:web-api": "npm --prefix web-api-app run build",
    "preflight": "node ./scripts/preflight.mjs",
    "agent": "node ./scripts/spark-agent.mjs",
    "start-services": "GPU_MEMORY_PROFILE=image-max node ./scripts/start-services.mjs",
    "start-services:chat-max": "GPU_MEMORY_PROFILE=chat-max node ./scripts/start-services.mjs",
    "start-services:image-max": "GPU_MEMORY_PROFILE=image-max node ./scripts/start-services.mjs",
    "sandbox": "node ./scripts/sandbox-runner.mjs",
    "cloud-proxy": "node ./scripts/cloud-key-proxy.mjs",
    "mempalace": "node ./scripts/mempalace-bridge.mjs",
    "test-ssh": "node ./scripts/test-ssh.mjs",
    "test-controller": "node ./scripts/test-controller.mjs",
    "test-tailscale": "node ./scripts/test-tailscale.mjs",
    "tunnel": "node ./scripts/spark-tunnel.mjs",
    "test-stream": "node ./scripts/test-stream-chunks.mjs",
    "audit-image": "node ./scripts/audit-image.mjs",
    "test-rag": "node ./scripts/test-rag.mjs",
    "test-model-resolve": "node ./scripts/test-model-resolve.mjs",
    "test-mesh-routing": "node ./scripts/test-mesh-routing.mjs",
    "build-rag-dataset": "node ./scripts/build-rag-dataset.mjs",
    "check-qwen": "node ./scripts/check-qwen.mjs",
    "check-gpu": "node ./scripts/check-gpu.mjs",
    "test-agent": "node ./scripts/test-agent.mjs",
    "sandbox:watch": "node ./scripts/sandbox-watchdog.mjs",
    "sandbox:install-launchd": "launchctl unload ~/Library/LaunchAgents/com.abliterated.sandbox-runner.plist 2>/dev/null; cp ./scripts/launchd/com.abliterated.sandbox-runner.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.abliterated.sandbox-runner.plist && echo loaded",
    "test-chat-history": "node ./scripts/test-chat-history.mjs",
    "test:phase2": "node ./scripts/test-phase2-pubsub.mjs",
    "test:phase3": "node ./scripts/test-phase3-maintenance.mjs",
    "rapid-debug": "bash ./scripts/rapid-debug.sh",
    "setup-hooks": "cp .githooks/pre-push .git/hooks/pre-push",
    "push:spark": "bash ./scripts/push-to-spark.sh",
    "run:all": "bash ./scripts/run-all-services.sh"
  },
  "private": true,
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
